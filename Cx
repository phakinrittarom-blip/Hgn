-- ระบบเสกหน้าอกแบบสมบูรณ์ (ปรับขนาด + ตำแหน่ง + สกินแนบชิด)
local fakeChestFolder = nil
local fakeChestEnabled = false

local function createFakeChest()
    local char = LocalPlayer.Character
    if not char then return end
    
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end

    if fakeChestFolder then fakeChestFolder:Destroy() end
    fakeChestFolder = Instance.new("Folder")
    fakeChestFolder.Name = "FakeChestContainer"
    fakeChestFolder.Parent = char

    local isR15 = char:FindFirstChild("UpperTorso") ~= nil
    local offsets = isR15 and {Vector3.new(-0.35, 0.15, -0.55), Vector3.new(0.35, 0.15, -0.55)} 
                           or {Vector3.new(-0.4, 0.2, -0.55), Vector3.new(0.4, 0.2, -0.55)}

    for _, offset in ipairs(offsets) do
        local p = Instance.new("Part")
        p.Name = "ChestPart"
        p.Size = Vector3.new(0.95, 0.95, 0.95)
        p.Shape = Enum.PartType.Ball
        p.CanCollide = false
        p.Material = torso.Material
        p.Color = torso.Color
        p.Parent = fakeChestFolder
        p.CFrame = torso.CFrame * CFrame.new(offset)

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = torso
        weld.Part1 = p
        weld.Parent = p
    end
end

PlayerTab:CreateToggle({
   Name = "เสกหน้าอกปลอม (Fake Chest)",
   CurrentValue = false,
   Callback = function(Value)
      fakeChestEnabled = Value
      if Value then
          createFakeChest()
      else
          if fakeChestFolder then fakeChestFolder:Destroy() end
      end
   end,
})

